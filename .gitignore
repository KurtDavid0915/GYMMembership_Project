# Node modules (installed dependencies)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript output
dist/
build/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# OS-specific files
.DS_Store       # macOS
Thumbs.db       # Windows
desktop.ini     # Windows

# VS Code settings (optional, if you want them local)
.vscode/

# Optional coverage reports (if using testing tools like Jest)
coverage/

# Temporary files
*.tmp
*.swp
*.swo
